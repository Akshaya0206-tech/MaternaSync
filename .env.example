# Vite reads .env.local (not this file). Copy this to .env.local to try it locally; on Vercel, set the same name under
# Project -> Settings -> Environment Variables (for Production, Preview and Development) and redeploy.
#
# Where the API lives, with no trailing slash. Leave it empty to call the same address as the page, which is how local
# development works (Vite proxies /api to VITE_API_TARGET). On Vercel the page and the API are on different hosts, so set it:
#   VITE_API_BASE_URL=https://maternasync-api.onrender.com
# The API must then list this site's address in MATERNASYNC_CORS_ORIGINS.
VITE_API_BASE_URL=
