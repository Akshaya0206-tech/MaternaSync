# Copy to backend/.env.local (ignored by git), then fill in your own credentials.
# Load explicitly with uvicorn --env-file backend/.env.local; config.py reads process environment.
MATERNASYNC_PHONE_OTP_ENABLED=true
TWILIO_ACCOUNT_SID=AC_REPLACE_WITH_YOUR_ACCOUNT_SID
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=VA_REPLACE_WITH_YOUR_VERIFY_SERVICE_SID
MATERNASYNC_JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
MATERNASYNC_OTP_DAILY_SEND_LIMIT=20
